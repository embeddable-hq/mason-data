    "@mason-data/extensions-darwin-x64": "0.8.0",
    "@mason-data/extensions-linux-arm64": "0.8.0",
    "@mason-data/extensions-linux-x64": "0.8.0",
    "@mason-data/extensions-win32-x64": "0.8.0"
