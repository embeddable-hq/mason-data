# mason serve's settings (mason serve --help has every one). Copy to .env beside compose.yml.

# The database to copy from. Mason only reads it: SELECTs (the default), or a replication slot with
# MASON_CHANGES=replication (README.md "Your database" says what each needs).
DATABASE_URL=postgres://mason_reader:password@db.example.com:5432/app

# What the users' passwords are made with (mason user add): openssl rand -hex 24
MASON_API_KEY=

# The Postgres API's TLS: a certificate made on the volume at the first start, which encrypts but proves nothing
# about whose server it is (clients connect with sslmode=require); or a certificate a CA signed, mounted in.
MASON_PG_SELF_SIGNED_TLS=1
# MASON_PG_TLS_CERT=/mason/data/tls/server.crt
# MASON_PG_TLS_KEY=/mason/data/tls/server.key

# How changes are read: poll (SELECTs on xmin, the default) or replication (the change log)
# MASON_CHANGES=replication
# PG_PUBLICATION=app_pub

# The copy's memory: half the container's memory limit by default (mason doctor says it); the other half is the page
# cache, Node and the catalog (~820 MB). Give the container enough to cache what your dashboards read (README.md "Memory")
# MASON_DUCKDB_MEMORY=4GB

# A copy: its chunks read at once, each a backend on the database (default 3), and how long each takes to read at
# the rate measured on this connection (default 12 s)
# MASON_COPY_PARALLEL=3
# MASON_COPY_CHUNK_SECONDS=12
